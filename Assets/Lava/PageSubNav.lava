{% comment %}
    Sidebar sub-navigation — for a Page Menu block placed in a "Sidebar 1"
    zone (LeftSidebar / RightSidebar layouts). Renders the current section's
    child pages as a simple vertical list using Rock's stock nav classes,
    which core.css styles.

    Block settings:
      * Template:            {% include '~~/Assets/Lava/PageSubNav.lava' %}
      * Root Page:           the section's parent page
      * Number of Levels:    1
{% endcomment %}
{% if Page.DisplayChildPages and Page.Pages != empty %}
    <ul class="nav nav-stacked">
        <li><a href="{{ Page.Url }}">{{ Page.Title }}</a></li>
        {% for childPage in Page.Pages %}
            <li{% if childPage.Current %} class="active"{% endif %}>
                <a href="{{ childPage.Url }}">{{ childPage.Title }}</a>
            </li>
        {% endfor %}
        {% assign currentPath = 'Global' | Page:'Path' %}
        {% for includedPage in IncludePageList %}
            {% assign attributeParts = includedPage | PropertyToKeyValue %}
            <li{% if currentPath == attributeParts.Value %} class="active"{% endif %}>
                <a href="{{ attributeParts.Value }}">{{ attributeParts.Key }}</a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
